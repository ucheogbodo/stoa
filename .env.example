# Copy to .env.local (gitignored) and fill in. On Vercel, set these in
# Project → Settings → Environment Variables, separately per environment.

# Runtime DB connection. On Vercel use Supabase's TRANSACTION pooler (port 6543):
#   postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
# Do NOT append ?pgbouncer=true (that's a Prisma-only flag).
DATABASE_URL=

# Optional: direct/session connection (port 5432) used only by drizzle-kit migrations.
DATABASE_URL_DIRECT=
